From 2ab3bffaec47a8f4cd40a52a4ebd0d8db2ed8867 Mon Sep 17 00:00:00 2001
From: Frank Wunderlich <frank-w@public-files.de>
Date: Fri, 14 Nov 2025 19:42:05 +0100
Subject: [PATCH 06/10] crypto-03-avoid-rcu-stall

based on
https://git01.mediatek.com/plugins/gitiles/openwrt/feeds/mtk-openwrt-feeds/+/8630c64a5f0f1c15a11b66e61a62a3d80f5aa197/master/files/target/linux/mediatek/patches-6.12/999-crypto-03-avoid-rcu-stall.patch
---
 drivers/crypto/inside-secure/safexcel.c | 14 +++-----------
 1 file changed, 3 insertions(+), 11 deletions(-)

diff --git a/drivers/crypto/inside-secure/safexcel.c b/drivers/crypto/inside-secure/safexcel.c
index e27f320e263c..27a738dc31cd 100644
--- a/drivers/crypto/inside-secure/safexcel.c
+++ b/drivers/crypto/inside-secure/safexcel.c
@@ -1038,7 +1038,6 @@ static inline void safexcel_handle_result_descriptor(struct safexcel_crypto_priv
 	int ret, i, nreq, ndesc, tot_descs, handled = 0;
 	bool should_complete;
 
-handle_results:
 	tot_descs = 0;
 
 	nreq = readl(EIP197_HIA_RDR(priv, ring) + EIP197_HIA_xDR_PROC_COUNT);
@@ -1047,6 +1046,7 @@ static inline void safexcel_handle_result_descriptor(struct safexcel_crypto_priv
 	if (!nreq)
 		goto requests_left;
 
+	local_bh_disable();
 	for (i = 0; i < nreq; i++) {
 		req = safexcel_rdr_req_get(priv, ring);
 
@@ -1059,15 +1059,13 @@ static inline void safexcel_handle_result_descriptor(struct safexcel_crypto_priv
 			goto acknowledge;
 		}
 
-		if (should_complete) {
-			local_bh_disable();
+		if (should_complete)
 			crypto_request_complete(req, ret);
-			local_bh_enable();
-		}
 
 		tot_descs += ndesc;
 		handled++;
 	}
+	local_bh_enable();
 
 acknowledge:
 	if (i)
@@ -1075,12 +1073,6 @@ static inline void safexcel_handle_result_descriptor(struct safexcel_crypto_priv
 		       (tot_descs * priv->config.rd_offset),
 		       EIP197_HIA_RDR(priv, ring) + EIP197_HIA_xDR_PROC_COUNT);
 
-	/* If the number of requests overflowed the counter, try to proceed more
-	 * requests.
-	 */
-	if (nreq == EIP197_xDR_PROC_xD_PKT_MASK)
-		goto handle_results;
-
 requests_left:
 	spin_lock_bh(&priv->ring[ring].lock);
 

